    const scanMotionState = {
        stepScale: 0.72,
        bounceCount: 0,
        retryCount: 0,
        lastBounceLogAt: 0
    };

    function isScrollable(element) {
        if (!(element instanceof HTMLElement)) return false;
        if (element.scrollHeight <= element.clientHeight + 80) return false;

        const style = getComputedStyle(element);
        return ['auto', 'scroll', 'overlay'].includes(style.overflowY);
    }

    function scrollPosition(scroller) {
        return {
            top: Math.round(scroller.scrollTop),
            height: Math.round(scroller.scrollHeight),
            client: Math.round(scroller.clientHeight)
        };
    }

    function physicalScrollSign(direction) {
        const value = Number(activeSiteAdapter.scrollSign(direction));
        return value < 0 ? -1 : 1;
    }

    function chronologicalExtremeItemId(direction) {
        let extreme = null;

        for (const id of visibleItemIds()) {
            if (extreme === null) {
                extreme = id;
                continue;
            }

            const comparison = compareItemIds(id, extreme);
            if (
                (direction === 'older' && comparison < 0) ||
                (direction === 'newer' && comparison > 0)
            ) {
                extreme = id;
            }
        }

        return extreme;
    }

    function itemProgressed(direction, beforeId, afterId) {
        if (!beforeId || !afterId) return false;
        const comparison = compareItemIds(afterId, beforeId);
        return direction === 'older' ? comparison < 0 : comparison > 0;
    }

    function isAtPhysicalBoundary(scroller, sign, tolerance = 6) {
        const position = scrollPosition(scroller);
        return sign < 0
            ? position.top <= tolerance
            : position.top + position.client >= position.height - tolerance;
    }

    function moveToPhysicalBoundary(scroller, sign) {
        scroller.scrollTop = sign < 0 ? 0 : scroller.scrollHeight;
    }

    async function waitForScrollSettle(scroller, durationMs = SCAN_SETTLE_WINDOW_MS) {
        const startedAt = performance.now();
        let previous = scrollPosition(scroller);
        let stableRounds = 0;

        while (performance.now() - startedAt < durationMs) {
            await sleep(90);
            const current = scrollPosition(scroller);
            const stable =
                Math.abs(current.top - previous.top) < 3 &&
                Math.abs(current.height - previous.height) < 3;
            stableRounds = stable ? stableRounds + 1 : 0;
            previous = current;
            if (stableRounds >= 2) break;
        }
    }

    async function stabilizedScrollStep(scroller, direction) {
        const sign = physicalScrollSign(direction);
        const before = scrollPosition(scroller);
        const beforeExtreme = chronologicalExtremeItemId(direction);
        const baseStep = Math.max(
            Math.floor(before.client * scanMotionState.stepScale),
            360
        );

        for (let attempt = 0; attempt < 4 && !stopRequested; attempt++) {
            const attemptScale = 1 / (1 + attempt * 0.42);
            const intendedDelta = sign * Math.max(
                220,
                Math.round(baseStep * attemptScale)
            );
            const attemptStart = scrollPosition(scroller);

            scroller.scrollBy({
                top: intendedDelta,
                left: 0,
                behavior: 'auto'
            });

            await sleep(150);
            const firstSample = scrollPosition(scroller);
            scanVisiblePage();
            await waitForScrollSettle(scroller);
            scanVisiblePage();

            const after = scrollPosition(scroller);
            const afterExtreme = chronologicalExtremeItemId(direction);
            const idProgress = itemProgressed(
                direction,
                beforeExtreme,
                afterExtreme
            );
            const pixelDelta = after.top - attemptStart.top;
            const pixelProgress = sign * pixelDelta > 18;
            const firstPixelDelta = firstSample.top - attemptStart.top;
            const bouncedBack =
                sign * firstPixelDelta > 18 &&
                sign * pixelDelta < Math.max(8, sign * firstPixelDelta * 0.28) &&
                !idProgress;

            if (idProgress || pixelProgress) {
                scanMotionState.stepScale = clamp(
                    scanMotionState.stepScale + 0.025,
                    0.48,
                    0.82
                );
                return {
                    progressed: true,
                    bouncedBack: false,
                    atBoundary: isAtPhysicalBoundary(scroller, sign)
                };
            }

            scanMotionState.retryCount++;
            if (bouncedBack) {
                scanMotionState.bounceCount++;
                scanMotionState.stepScale = clamp(
                    scanMotionState.stepScale * 0.78,
                    0.42,
                    0.82
                );

                const now = performance.now();
                if (now - scanMotionState.lastBounceLogAt > 8_000) {
                    addLog(
                        `${activeSiteAdapter.label} re-anchored the virtual timeline. ` +
                        'The scanner reduced its step and retried without losing the current frontier.',
                        'warn'
                    );
                    scanMotionState.lastBounceLogAt = now;
                }
            }

            // Do not restore the previous absolute scrollTop. Virtualized
            // lists change their coordinate system; retry from the position
            // the site finally settled on instead.
            await sleep(90 + attempt * 80);
        }

        return {
            progressed: false,
            bouncedBack: true,
            atBoundary: isAtPhysicalBoundary(scroller, sign)
        };
    }

    async function forceMoveToChronologicalBoundary(
        scroller,
        direction,
        durationMs = FINAL_NEWEST_SETTLE_MS
    ) {
        const sign = physicalScrollSign(direction);
        const startedAt = performance.now();
        let stableRounds = 0;
        let previousExtreme = null;
        let previousHeight = -1;

        while (!stopRequested && performance.now() - startedAt < durationMs) {
            moveToPhysicalBoundary(scroller, sign);
            await sleep(320);
            scanVisiblePage();

            const position = scrollPosition(scroller);
            const currentExtreme = chronologicalExtremeItemId(direction);
            const stable =
                isAtPhysicalBoundary(scroller, sign, 8) &&
                currentExtreme === previousExtreme &&
                Math.abs(position.height - previousHeight) < 3;

            stableRounds = stable ? stableRounds + 1 : 0;
            previousExtreme = currentExtreme;
            previousHeight = position.height;

            if (stableRounds >= 4 && performance.now() - startedAt >= 1500) {
                break;
            }
        }

        for (let pass = 0; pass < 2; pass++) {
            moveToPhysicalBoundary(scroller, sign);
            await sleep(420);
        }

        return isAtPhysicalBoundary(scroller, sign, 10);
    }

    async function restoreStartingAnchor(scroller, anchor) {
        if (!anchor) return false;

        for (
            let step = 0;
            step < RESTORE_POSITION_MAX_STEPS &&
            !stopRequested;
            step++
        ) {
            const element = findItemElementById(anchor.itemId);

            if (element) {
                const scrollerRect = scroller.getBoundingClientRect();
                const delta =
                    element.getBoundingClientRect().top -
                    scrollerRect.top -
                    anchor.offset;

                scroller.scrollBy({ top: delta, behavior: 'auto' });
                await waitForScrollSettle(scroller, 650);
                return true;
            }

            if (!anchor.itemId) break;

            const oldest = chronologicalExtremeItemId('older');
            const newest = chronologicalExtremeItemId('newer');
            let direction = null;

            if (oldest && compareItemIds(anchor.itemId, oldest) < 0) {
                direction = 'older';
            } else if (newest && compareItemIds(anchor.itemId, newest) > 0) {
                direction = 'newer';
            }

            if (!direction) break;
            await stabilizedScrollStep(scroller, direction);
        }

        const position = scrollPosition(scroller);
        scroller.scrollTop =
            anchor.scrollRatio *
            Math.max(0, position.height - position.client);
        await waitForScrollSettle(scroller, 600);
        return false;
    }

    function finalPositionDescription(value) {
        switch (value) {
            case 'scan-end':
                return 'Stay at scan end';
            case 'start':
                return 'Return to starting position';
            default:
                return 'Jump to newest after scan / ZIP';
        }
    }

    async function applyFinalTimelinePosition(
        scroller,
        option,
        startingAnchor
    ) {
        if (stopRequested || option === 'scan-end') return;

        if (option === 'start') {
            setPhase('RETURNING TO START POSITION');
            addLog('Returning to the position where the scan started.');

            const exact = await restoreStartingAnchor(scroller, startingAnchor);
            addLog(
                exact
                    ? 'Starting position restored.'
                    : `Starting position restored approximately because ${activeSiteAdapter.label} unloaded the original ${adapterTerm('item', 'item')}.`,
                exact ? 'success' : 'warn'
            );
            return;
        }

        setPhase('RETURNING TO NEWEST');
        addLog(
            `Returning to the newest ${adapterTerm('item', 'item')} and waiting for the virtual timeline to settle.`
        );

        const reached = await forceMoveToChronologicalBoundary(
            scroller,
            'newer'
        );
        addLog(
            reached
                ? 'Final position is now at the newest timeline boundary.'
                : `${activeSiteAdapter.label} moved the timeline again; the strongest position correction was applied.`,
            reached ? 'success' : 'warn'
        );
    }

    async function moveToNewest(scroller) {
        setPhase('SCAN: moving to newest');
        addLog('Moving to the newest timeline boundary first.');
        await forceMoveToChronologicalBoundary(scroller, 'newer', 5_500);
    }

    async function moveToOldest(scroller) {
        setPhase('SCAN: moving to oldest');
        addLog('Moving to the oldest timeline boundary first.');
        await forceMoveToChronologicalBoundary(scroller, 'older', 5_500);
    }
