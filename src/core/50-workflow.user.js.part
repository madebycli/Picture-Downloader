    async function executeScanPlan(scroller, plan) {
        let completed = false;
        let finalLabel = '';

        for (let index = 0; index < plan.length && !stopRequested; index++) {
            const step = plan[index];
            lastScanBoundaryReason = '';

            if (step.type === 'move-newest') {
                await moveToNewest(scroller);
                continue;
            }
            if (step.type === 'move-oldest') {
                await moveToOldest(scroller);
                continue;
            }
            if (step.type === 'scan') {
                const reached = step.direction === 'older'
                    ? await autoScrollToOldest(scroller)
                    : await autoScrollToNewest(scroller);
                completed = reached;
                finalLabel = scanBoundaryDescription(lastScanBoundaryReason);

                if (!reached) {
                    addLog(
                        `The ${step.direction} scan could not confirm its boundary. ` +
                        'The remaining plan was stopped to avoid skipping an unknown section.',
                        'warn'
                    );
                    break;
                }
            }
        }

        return { completed, finalLabel };
    }

    async function startAutomaticWorkflow() {
        if (running) return;

        resetCollection({ clearCheckpoint: false });
        stopRequested = false;
        running = true;
        scanning = true;
        packing = false;
        updateButtons();

        const dateRange = getDateRangeConfig();
        if (!dateRange.valid) {
            running = false;
            scanning = false;
            setPhase('DATE RANGE ERROR');
            addLog(dateRange.error, 'error');
            updateButtons();
            return;
        }

        lastScanBoundaryReason = '';
        setPhase('STARTING');
        addLog(`Scan started on ${activeSiteAdapter.label}.`);

        if (dateRange.enabled) {
            addLog(
                `Requested period: ${dateRange.label}. ` +
                'The smart planner will choose the shortest safe chronological path.'
            );
        } else if (adapterDateRangeSupport() === 'none') {
            addLog(
                `${activeSiteAdapter.label} does not expose reliable dates in this view; ` +
                'the date filter is disabled and the feed order is used.',
                'warn'
            );
        }

        if (onlyNewCheckbox.checked) {
            const latest = latestIndexedTimestampMilliseconds();
            addLog(
                Number.isFinite(latest)
                    ? `Incremental mode: scan stops after crossing the previous archive frontier (${new Date(latest).toLocaleString('en-GB')}).`
                    : 'Incremental mode: no previous archive frontier exists yet, so this run establishes one.'
            );
        }

        await sleep(250);
        const scroller = findTimelineScroller();
        if (!scroller) {
            running = false;
            scanning = false;
            setPhase('ERROR');
            addLog(
                `${activeSiteAdapter.label} ${adapterTerm('timeline', 'timeline')} was not found. ` +
                `${activeSiteAdapter.openTargetHelp || ''}`,
                'error'
            );
            updateButtons();
            return;
        }

        scanVisiblePage();
        const startingAnchor = captureStartingAnchor(scroller);
        const plan = selectedScanPlan();
        addLog(
            `${scanStrategySelect.value === 'smart' ? 'Smart' : 'Manual'} scan plan: ` +
            `${describeScanPlan(plan)}.`
        );

        const result = await executeScanPlan(scroller, plan);
        scanning = false;

        if (stopRequested) {
            finishStoppedScan();
            return;
        }

        running = false;
        saveSessionCheckpoint();
        updateCounters();
        updateButtons();

        if (result.completed) {
            setPhase(`SCAN FINISHED: ${mediaEntries.size} media files`);
            addLog(
                `Scan completed at the ${result.finalLabel}: ` +
                `${mediaEntries.size} unique source files found.`,
                'success'
            );
        } else {
            setPhase(`SCAN ENDED: ${mediaEntries.size} media files`);
            addLog(
                'The scan ended without a fully confirmed boundary. The collected checkpoint was preserved.',
                'warn'
            );
        }

        const stats = selectionStatistics();
        addLog(
            `Selection summary: ${stats.total} found, ${stats.selected} selected, ` +
            `${stats.excludedByIndex} already indexed, ${stats.excludedByPick} outside page picks.`
        );

        const shouldCreateZip =
            selectedMediaEntries().length > 0 &&
            autoZipCheckbox.checked;

        if (shouldCreateZip) {
            await createAndDownloadZipParts();
        }

        if (!stopRequested) {
            await applyFinalTimelinePosition(
                scroller,
                finalPositionSelect.value,
                startingAnchor
            );
            setPhase(
                shouldCreateZip
                    ? 'FINISHED'
                    : `SCAN FINISHED: ${mediaEntries.size} media files`
            );
        }
    }

    function finishStoppedScan() {
        scanning = false;
        running = false;
        saveSessionCheckpoint();
        setPhase(`STOPPED: ${mediaEntries.size} media files collected`);
        addLog(
            'Scrolling stopped. The session checkpoint was saved; create ZIPs now or restore it after a reload.',
            'warn'
        );
        updateButtons();
    }

    function requestStop() {
        if (!running && !packing && !scanning) return;
        stopRequested = true;
        abortActiveRequests();
        setPhase('STOPPING …');
        addLog('Stop requested.', 'warn');
        updateButtons();
    }

    function resetEntryStatuses() {
        for (const entry of mediaEntries.values()) {
            entry.status = STATUS.COLLECTED;
            entry.error = '';
            entry.size = 0;
            entry.contentHash = null;
        }
        scheduleRender();
    }

    function resetCollection({ clearCheckpoint = true } = {}) {
        if (running || packing || scanning) return;

        mediaEntries.clear();
        manualPickedKeys.clear();
        lastPickedKey = null;
        firstSeenCounter = 0;
        progressFill.style.width = '0%';
        mediaList.replaceChildren();
        refreshPageSelectionTargets();
        if (clearCheckpoint) clearSessionCheckpoint();
        updateCounters();
        setPhase('READY');
    }

    function formatBytes(bytes) {
        if (!Number.isFinite(bytes) || bytes <= 0) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB'];
        const power = Math.min(
            Math.floor(Math.log(bytes) / Math.log(1024)),
            units.length - 1
        );
        return `${(bytes / (1024 ** power)).toFixed(power ? 1 : 0)} ${units[power]}`;
    }

    function statusIcon(entry) {
        if (!isEntryIncluded(entry) && entry.status === STATUS.COLLECTED) {
            return ['–', entrySkipReason(entry), 'skipped'];
        }

        switch (entry.status) {
            case STATUS.FETCHING:
                return ['…', 'Downloading original', 'fetching'];
            case STATUS.PACKED:
                return ['✓', 'Saved in ZIP and indexed', 'packed'];
            case STATUS.DUPLICATE:
                return ['=', 'Exact duplicate skipped and indexed', 'duplicate'];
            case STATUS.ERROR:
                return ['!', entry.error || 'Error', 'error'];
            default:
                return ['○', 'Collected', 'collected'];
        }
    }

    function scheduleRender() {
        clearTimeout(renderTimer);
        renderTimer = setTimeout(renderMediaList, 100);
    }

    function handleMediaRowSelection(event, entry) {
        if (running || packing || scanning) return;
        const willSelect = !manualPickedKeys.has(entry.key);

        if (event.shiftKey && lastPickedKey) {
            selectPickedRange(lastPickedKey, entry.key, willSelect);
        } else {
            togglePickedEntry(entry.key, willSelect);
        }
    }

    function renderMediaList() {
        const entries = sortedMediaEntries();
        const fragment = document.createDocumentFragment();

        entries.forEach((entry, index) => {
            const row = document.createElement('button');
            row.type = 'button';
            row.className = `ma-row ma-${entry.status}`;
            row.dataset.key = entry.key;
            row.title = 'Click to pick this item; Shift-click selects a range.';
            if (!isEntryIncluded(entry)) row.classList.add('ma-skipped');
            if (manualPickedKeys.has(entry.key)) {
                row.classList.add('ma-row-picked');
            }

            let thumbnail;
            if (
                entry.mediaType === 'video' ||
                entry.mediaType === 'external-gif'
            ) {
                thumbnail = document.createElement('div');
                thumbnail.className = 'ma-thumb ma-video-thumb';
                thumbnail.textContent = entry.mediaType === 'external-gif'
                    ? 'GIF'
                    : '▶';
            } else {
                thumbnail = document.createElement('img');
                thumbnail.className = 'ma-thumb';
                thumbnail.loading = 'lazy';
                thumbnail.referrerPolicy = 'no-referrer';
                thumbnail.src = entry.previewUrl;
                thumbnail.alt = '';
            }

            const details = document.createElement('div');
            details.className = 'ma-details';
            const name = document.createElement('div');
            name.className = 'ma-name';
            name.textContent =
                `${String(index + 1).padStart(4, '0')} · ${entry.filename}`;
            const meta = document.createElement('div');
            meta.className = 'ma-meta';
            meta.textContent = [
                entry.mediaType === 'external-gif'
                    ? 'GIF PREVIEW'
                    : entry.mediaType.toUpperCase(),
                entry.timestamp
                    ? new Date(entry.timestamp).toLocaleString('en-GB')
                    : 'Time unknown',
                entry.size ? formatBytes(entry.size) : '',
                isEntryPreviouslyArchived(entry) ? 'INDEXED' : ''
            ].filter(Boolean).join(' · ');
            details.append(name, meta);

            const pick = document.createElement('span');
            pick.className = 'ma-pick-indicator';
            pick.textContent = manualPickedKeys.has(entry.key) ? '✓' : '+';
            pick.title = manualPickedKeys.has(entry.key)
                ? 'Picked for manual selection'
                : 'Add to manual selection';

            const [symbol, title, className] = statusIcon(entry);
            const status = document.createElement('span');
            status.className = `ma-check ma-check-${className}`;
            status.textContent = symbol;
            status.title = title;

            const indicators = document.createElement('span');
            indicators.className = 'ma-row-indicators';
            indicators.append(pick, status);

            row.append(thumbnail, details, indicators);
            row.addEventListener('click', event => {
                handleMediaRowSelection(event, entry);
            });
            fragment.appendChild(row);
        });

        mediaList.replaceChildren(fragment);
        updateCounters();
    }

    function addLog(message, type = 'info') {
        const line = document.createElement('div');
        line.className = `ma-log-line ma-log-${type}`;
        const time = new Date().toLocaleTimeString('en-GB');
        line.textContent = `[${time}] ${message}`;
        logArea.appendChild(line);
        while (logArea.childElementCount > 300) {
            logArea.firstElementChild?.remove();
        }
        logArea.scrollTop = logArea.scrollHeight;
    }

    function setPhase(value) {
        phaseElement.textContent = value;
    }

    function updateCounters() {
        let packedCount = 0;
        let errorCount = 0;

        for (const entry of mediaEntries.values()) {
            if (entry.status === STATUS.PACKED) packedCount++;
            if (entry.status === STATUS.ERROR) errorCount++;
        }

        const counts = countMediaTypes();
        const stats = selectionStatistics();

        foundElement.textContent = String(stats.total);
        photoCountElement.textContent = String(counts.photos);
        videoCountElement.textContent = String(counts.videos);
        externalGifCountElement.textContent = String(counts.externalGifs);
        inRangeElement.textContent = String(stats.inDateRange);
        excludedDateElement.textContent = String(stats.excludedByDate);
        indexedElement.textContent = String(stats.excludedByIndex);
        duplicateElement.textContent = String(stats.duplicateCount);
        pickedElement.textContent = String(pickedEntryCount());
        selectedCountElement.textContent = String(stats.selected);
        selectedSummaryElement.textContent = `${stats.selected} selected`;
        mediaTabCount.textContent = String(stats.total);
        packedElement.textContent = String(packedCount);
        errorElement.textContent = String(errorCount);

        pickerToolbarCount.textContent = `${pickedEntryCount()} picked`;
        refreshLibrarySummary?.();
        refreshPagePickerControls?.();
        updateButtons();
    }

    function updateButtons() {
        const selectedCount = selectedMediaEntries().length;
        const busy = running || packing || scanning;
        const dateRange = getDateRangeConfig();

        startButton.textContent = autoZipCheckbox.checked
            ? 'Scan & archive'
            : 'Scan media';
        startButton.disabled =
            busy ||
            (
                !photoCheckbox.checked &&
                !videoCheckbox.checked &&
                !externalGifCheckbox.checked
            ) ||
            !dateRange.valid;
        stopButton.disabled = !busy;
        zipButton.disabled = busy || selectedCount === 0 || !dateRange.valid;
        resetButton.disabled = busy;

        for (const control of [
            autoZipCheckbox,
            photoCheckbox,
            videoCheckbox,
            externalGifCheckbox,
            scanStrategySelect,
            scanDirectionSelect,
            finalPositionSelect,
            dateFilterCheckbox,
            fromDateInput,
            dateEndModeSelect,
            toDateInput,
            onlyNewCheckbox,
            exactDedupeCheckbox,
            pickedOnlyCheckbox,
            filenameModeSelect,
            archiveNameInput,
            zipTargetInput,
            zipEngineSelect,
            profileSelect,
            profileNameInput
        ]) {
            if (control) control.disabled = busy;
        }

        dateFilterCheckbox.disabled =
            busy || adapterDateRangeSupport() === 'none';
        fromDateInput.disabled = busy || !dateFilterCheckbox.checked;
        dateEndModeSelect.disabled = busy || !dateFilterCheckbox.checked;
        toDateInput.disabled =
            busy ||
            !dateFilterCheckbox.checked ||
            dateEndModeSelect.value !== 'specific';
        pagePickerButton.disabled = busy;
        pickerDownloadButton.disabled = busy || pickedEntryCount() === 0;
        pickerClearButton.disabled = busy || pickedEntryCount() === 0;
    }
