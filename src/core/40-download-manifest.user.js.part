    function abortActiveRequests() {
        for (const request of activeRequests) {
            try {
                request.abort();
            } catch {
                // Ignore already-finished requests.
            }
        }
        activeRequests.clear();
    }

    function requestArrayBuffer(url, attempt = 1) {
        return new Promise((resolve, reject) => {
            if (!activeSiteAdapter.isDownloadUrlAllowed(url)) {
                reject(new Error('The active site adapter blocked this download URL.'));
                return;
            }
            if (stopRequested) {
                reject(new Error('Stopped by user'));
                return;
            }

            let requestHandle;
            requestHandle = GM_xmlhttpRequest({
                method: 'GET',
                url,
                responseType: 'arraybuffer',
                timeout: 180000,
                anonymous: true,
                headers: {
                    Accept: 'video/*,image/*,*/*;q=0.8'
                },
                onload: async response => {
                    activeRequests.delete(requestHandle);

                    if (
                        response.status >= 200 &&
                        response.status < 300 &&
                        response.response
                    ) {
                        resolve(response.response);
                        return;
                    }

                    const retryable =
                        response.status === 408 ||
                        response.status === 429 ||
                        response.status >= 500 ||
                        response.status === 0;

                    if (retryable && attempt < REQUEST_RETRIES && !stopRequested) {
                        await sleep(750 * attempt);
                        try {
                            resolve(await requestArrayBuffer(url, attempt + 1));
                        } catch (error) {
                            reject(error);
                        }
                        return;
                    }

                    reject(new Error(`HTTP ${response.status || 'unknown'}`));
                },
                onerror: async () => {
                    activeRequests.delete(requestHandle);
                    if (attempt < REQUEST_RETRIES && !stopRequested) {
                        await sleep(750 * attempt);
                        try {
                            resolve(await requestArrayBuffer(url, attempt + 1));
                        } catch (error) {
                            reject(error);
                        }
                        return;
                    }
                    reject(new Error('Network error'));
                },
                ontimeout: async () => {
                    activeRequests.delete(requestHandle);
                    if (attempt < REQUEST_RETRIES && !stopRequested) {
                        await sleep(750 * attempt);
                        try {
                            resolve(await requestArrayBuffer(url, attempt + 1));
                        } catch (error) {
                            reject(error);
                        }
                        return;
                    }
                    reject(new Error('Request timed out'));
                }
            });

            activeRequests.add(requestHandle);
        });
    }

    async function runWorkerPool(items, concurrency, worker) {
        let cursor = 0;

        async function runner() {
            while (!stopRequested) {
                const current = cursor++;
                if (current >= items.length) return;
                await worker(items[current], current);
            }
        }

        await Promise.all(
            Array.from(
                { length: Math.min(concurrency, items.length) },
                () => runner()
            )
        );
    }

    function resolvedMediaExtension(entry) {
        let extension = '';
        try {
            extension = extensionFromPath(
                new URL(entry.url, location.href).pathname
            );
        } catch {
            // Use original filename below.
        }

        if (!MEDIA_EXTENSIONS.has(extension)) {
            extension = extensionFromPath(`/${entry.filename}`);
        }
        if (!MEDIA_EXTENSIONS.has(extension)) {
            extension =
                entry.mediaType === 'video' ||
                entry.mediaType === 'external-gif'
                    ? '.mp4'
                    : '.jpg';
        }
        return extension;
    }

    function filenameStem(value) {
        const clean = sanitizeFilename(value, 'media');
        const extension = extensionFromPath(`/${clean}`);
        return extension ? clean.slice(0, -extension.length) : clean;
    }

    function timestampFilenameToken(entry) {
        const date = new Date(entry.timestamp || '');
        if (!Number.isFinite(date.getTime())) return 'unknown-time';
        return date.toISOString().replace(/[:]/g, '-').replace('.000Z', 'Z');
    }

    function ensureUniqueArchiveFilename(candidate, usedNames) {
        const extension = extensionFromPath(`/${candidate}`);
        const stem = extension
            ? candidate.slice(0, -extension.length)
            : candidate;
        let unique = candidate;
        let suffix = 2;

        while (usedNames.has(unique.toLowerCase())) {
            unique = `${stem}_${suffix}${extension}`;
            suffix++;
        }
        usedNames.add(unique.toLowerCase());
        return unique;
    }

    function uniqueArchiveName(index, entry, digits, usedNames) {
        const width = Math.max(6, digits);
        const sequence = String(index + 1).padStart(width, '0');
        const extension = resolvedMediaExtension(entry);
        const mode = filenameModeSelect?.value || 'sequential';
        const contextSlug = slugify(
            currentArchiveContext().collectionName,
            'collection'
        );
        const originalStem = filenameStem(entry.filename);

        let candidate;
        switch (mode) {
            case 'original':
                candidate = `${originalStem}${extension}`;
                break;
            case 'timestamp-original':
                candidate = `${timestampFilenameToken(entry)}_${originalStem}${extension}`;
                break;
            case 'context-sequential':
                candidate = `${contextSlug}_${sequence}${extension}`;
                break;
            default:
                candidate = `${sequence}${extension}`;
        }

        return ensureUniqueArchiveFilename(
            sanitizeFilename(candidate, `${sequence}${extension}`),
            usedNames
        );
    }

    function csvCell(value) {
        const text = String(value ?? '');
        return `"${text.replace(/"/g, '""')}"`;
    }

    function buildPartManifest(records, archiveNames, partNumber) {
        const rows = [[
            'order_newest_to_oldest',
            'zip_part',
            'archive_filename',
            'original_filename',
            'media_type',
            'source_kind',
            'source_fingerprint',
            'content_sha256',
            'source_page_url',
            'item_id',
            'timestamp',
            'size_bytes',
            'source_url'
        ].map(csvCell).join(',')];

        for (const record of records) {
            const entry = record.entry;
            rows.push([
                record.globalIndex + 1,
                partNumber,
                archiveNames.get(entry.key) || '',
                entry.filename,
                entry.mediaType,
                entry.sourceKind || '',
                sourceFingerprintForEntry(entry),
                record.contentHash || entry.contentHash || '',
                entry.sourcePageUrl || '',
                entry.itemId || '',
                entry.timestamp || '',
                entry.size || 0,
                entry.url
            ].map(csvCell).join(','));
        }

        return '\uFEFF' + rows.join('\r\n');
    }

    function resolveFflateLibrary() {
        const candidates = [];

        try {
            if (typeof fflate !== 'undefined') candidates.push(fflate);
        } catch {
            // Ignore unavailable lexical global.
        }
        try {
            candidates.push(globalThis?.fflate);
        } catch {
            // Ignore.
        }
        try {
            candidates.push(window?.fflate);
        } catch {
            // Ignore.
        }
        try {
            if (typeof unsafeWindow !== 'undefined') {
                candidates.push(unsafeWindow?.fflate);
            }
        } catch {
            // Ignore.
        }

        return candidates.find(candidate =>
            candidate &&
            typeof candidate.zipSync === 'function' &&
            typeof candidate.strToU8 === 'function'
        ) || null;
    }

    function encodeUtf8(value) {
        const library = resolveFflateLibrary();
        return library
            ? library.strToU8(String(value))
            : new TextEncoder().encode(String(value));
    }

    const FALLBACK_CRC32_TABLE = (() => {
        const table = new Uint32Array(256);
        for (let index = 0; index < 256; index++) {
            let value = index;
            for (let bit = 0; bit < 8; bit++) {
                value = (value & 1)
                    ? (0xEDB88320 ^ (value >>> 1))
                    : (value >>> 1);
            }
            table[index] = value >>> 0;
        }
        return table;
    })();

    function buildArchiveBaseName() {
        const context = currentArchiveContext();
        const custom = archiveNameInput?.value?.trim();
        const site = slugify(context.siteLabel, activeSiteAdapter.id);
        const collection = slugify(context.collectionName, context.id);
        return custom
            ? slugify(custom, `${site}_${collection}`)
            : `${site}_${collection}`;
    }

    function buildZipFilename(partNumber, archiveKind) {
        const stamp = new Date()
            .toISOString()
            .slice(0, 16)
            .replace('T', '_')
            .replace(':', '-');
        const part = String(partNumber).padStart(3, '0');
        return sanitizeFilename(
            `${buildArchiveBaseName()}_${archiveKind}_` +
            `${dateRangeFilenameToken()}_${stamp}_part-${part}.zip`,
            `media_archive_part-${part}.zip`
        );
    }
