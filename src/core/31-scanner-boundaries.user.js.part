    async function confirmRealChronologicalBoundary(scroller, direction) {
        const sign = physicalScrollSign(direction);
        const startedAt = performance.now();
        const waitDuration = direction === 'older'
            ? REAL_TOP_CONFIRM_MS
            : REAL_BOTTOM_CONFIRM_MS;
        const baseline = {
            extremeId: chronologicalExtremeItemId(direction),
            mediaCount: mediaEntries.size,
            height: scrollPosition(scroller).height
        };

        addLog(
            `Possible ${direction === 'older' ? 'oldest' : 'newest'} boundary reached. ` +
            `Waiting ${Math.round(waitDuration / 1000)} seconds for delayed items.`
        );

        while (!stopRequested) {
            moveToPhysicalBoundary(scroller, sign);
            await sleep(BOUNDARY_PROBE_INTERVAL_MS);
            scanVisiblePage();

            const current = scrollPosition(scroller);
            const currentExtreme = chronologicalExtremeItemId(direction);
            const changed =
                itemProgressed(direction, baseline.extremeId, currentExtreme) ||
                mediaEntries.size > baseline.mediaCount ||
                Math.abs(current.height - baseline.height) >= 3 ||
                !isAtPhysicalBoundary(scroller, sign, 10);

            if (changed) {
                addLog(
                    `${activeSiteAdapter.label} loaded more content; scanning continues ` +
                    `(${mediaEntries.size} media files found).`,
                    'success'
                );
                return false;
            }

            const remaining = Math.max(
                0,
                waitDuration - (performance.now() - startedAt)
            );
            setPhase(
                `SCAN: confirming ${direction} boundary · ` +
                `${Math.ceil(remaining / 1000)} s left`
            );

            if (remaining <= 0) {
                scanVisiblePage();
                return true;
            }
        }

        return false;
    }

    async function autoScrollChronological(scroller, direction) {
        setPhase(
            direction === 'older'
                ? 'SCAN: toward older items'
                : 'SCAN: toward newer items'
        );
        addLog(
            `Scanning toward ${direction} items with adaptive anti-snapback steps.`
        );

        let iterations = 0;
        let stalledRounds = 0;

        while (!stopRequested && iterations < 30_000) {
            iterations++;
            scanVisiblePage();

            const result = await stabilizedScrollStep(scroller, direction);
            scanVisiblePage();

            const selectedBoundary = selectedDateBoundaryReached(direction);
            if (selectedBoundary) {
                lastScanBoundaryReason = selectedBoundary.reason;
                addLog(
                    `Scan frontier reached: ${selectedBoundary.label}.`,
                    'success'
                );
                return true;
            }

            if (result.progressed) {
                stalledRounds = 0;
            } else {
                stalledRounds++;
            }

            if (iterations % 25 === 0) {
                addLog(
                    `Scan running: ${mediaEntries.size} media files found; ` +
                    `${scanMotionState.bounceCount} virtual-list snapbacks recovered.`
                );
            }

            const sign = physicalScrollSign(direction);
            if (result.atBoundary || isAtPhysicalBoundary(scroller, sign, 6)) {
                const confirmed = await confirmRealChronologicalBoundary(
                    scroller,
                    direction
                );

                if (confirmed) {
                    lastScanBoundaryReason = direction === 'older'
                        ? 'timeline-start'
                        : 'timeline-end';
                    addLog(
                        `No additional ${direction} items appeared. Boundary confirmed.`,
                        'success'
                    );
                    return true;
                }
                stalledRounds = 0;
            } else if (stalledRounds >= 5) {
                // A virtualized list can reject several scroll writes while it
                // is reconciling heights. Pause, rescan, and continue from the
                // settled frontier instead of jumping back to an old pixel.
                addLog(
                    'The timeline temporarily resisted scrolling. Pausing for rendering, then retrying from the current frontier.',
                    'warn'
                );
                await sleep(1200);
                scanVisiblePage();
                stalledRounds = 0;
                scanMotionState.stepScale = clamp(
                    scanMotionState.stepScale * 0.82,
                    0.42,
                    0.82
                );
            }
        }

        return false;
    }

    function autoScrollToOldest(scroller) {
        return autoScrollChronological(scroller, 'older');
    }

    function autoScrollToNewest(scroller) {
        return autoScrollChronological(scroller, 'newer');
    }

    function scanModeDescription(mode) {
        switch (mode) {
            case 'current-to-oldest':
                return 'Current position → older boundary';
            case 'current-to-newest':
                return 'Current position → newer boundary';
            case 'full-finish-down':
                return 'Current → older boundary → newer boundary';
            default:
                return 'Newest → older boundary';
        }
    }
