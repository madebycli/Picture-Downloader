{
  "schemaVersion": 1,
  "adapters": [
    {
      "id": "discord",
      "label": "Discord",
      "matches": [
        "https://discord.com/channels/*",
        "https://ptb.discord.com/channels/*",
        "https://canary.discord.com/channels/*"
      ],
      "connect": [
        "cdn.discordapp.com",
        "media.discordapp.net",
        "images-ext-1.discordapp.net",
        "images-ext-2.discordapp.net"
      ],
      "modules": [
        "src/adapters/discord/00-config.user.js.part",
        "src/adapters/discord/10-embeds.user.js.part",
        "src/adapters/discord/20-items.user.js.part",
        "src/adapters/discord/30-timeline.user.js.part",
        "src/adapters/discord/90-register.user.js.part"
      ]
    }
  ]
}
