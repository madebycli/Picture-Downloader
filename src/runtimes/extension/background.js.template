'use strict';

const extensionApi = globalThis.browser || globalThis.chrome;
const allowedDownloadHosts = new Set(__ALLOWED_DOWNLOAD_HOSTS__);
const activeRequests = new Map();

function responseCode(status) {
    if (status === 403) return 'NETWORK_HTTP_403';
    if (status === 404) return 'NETWORK_HTTP_404';
    if (status === 429) return 'NETWORK_HTTP_429';
    if (status >= 500) return 'NETWORK_HTTP_5XX';
    return 'NETWORK_RETRY_EXHAUSTED';
}

function isAllowedUrl(rawUrl) {
    try {
        const url = new URL(rawUrl);
        return url.protocol === 'https:' && allowedDownloadHosts.has(url.hostname);
    } catch {
        return false;
    }
}

async function fetchBinary(message) {
    if (!isAllowedUrl(message.url)) {
        return {
            ok: false,
            code: 'NETWORK_HOST_REJECTED',
            message: 'The requested host is not declared by an installed adapter.',
            retryable: false
        };
    }

    const controller = new AbortController();
    const timeout = setTimeout(
        () => controller.abort('timeout'),
        Math.max(1_000, Number(message.timeoutMs) || 120_000)
    );
    activeRequests.set(message.requestId, controller);

    try {
        const response = await fetch(message.url, {
            method: 'GET',
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
            cache: 'no-store',
            headers: {
                Accept: message.accept || 'video/*,image/*,*/*;q=0.8'
            },
            signal: controller.signal
        });

        if (!response.ok) {
            return {
                ok: false,
                code: responseCode(response.status),
                message: `HTTP ${response.status}`,
                status: response.status,
                retryable: response.status === 429 || response.status >= 500
            };
        }

        return {
            ok: true,
            buffer: await response.arrayBuffer(),
            status: response.status
        };
    } catch (error) {
        const timeoutAbort = controller.signal.reason === 'timeout';
        return {
            ok: false,
            code: timeoutAbort ? 'NETWORK_TIMEOUT' : 'NETWORK_ABORTED',
            message: timeoutAbort ? 'Request timed out.' : 'Request aborted.',
            retryable: timeoutAbort
        };
    } finally {
        clearTimeout(timeout);
        activeRequests.delete(message.requestId);
    }
}

extensionApi.runtime.onMessage.addListener(message => {
    if (message?.type === 'media-archiver:fetch-binary') {
        return fetchBinary(message);
    }
    if (message?.type === 'media-archiver:abort-request') {
        const controller = activeRequests.get(message.requestId);
        controller?.abort('user');
        activeRequests.delete(message.requestId);
        return Promise.resolve({ aborted: Boolean(controller) });
    }
    if (message?.type === 'media-archiver:abort-all') {
        for (const controller of activeRequests.values()) controller.abort('user');
        activeRequests.clear();
        return Promise.resolve({ aborted: true });
    }
    return undefined;
});

async function openUiInActiveTab() {
    const tabs = await extensionApi.tabs.query({ active: true, currentWindow: true });
    const tab = tabs[0];
    if (!tab?.id) return;
    try {
        await extensionApi.tabs.sendMessage(tab.id, { type: 'media-archiver:open-ui' });
    } catch {
        // Unsupported pages intentionally have no content runtime to open.
    }
}

const action = extensionApi.action || extensionApi.browserAction;
action?.onClicked?.addListener(openUiInActiveTab);
